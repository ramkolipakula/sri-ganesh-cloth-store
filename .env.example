# Sri Ganesh Cloth Centre — Environment Variables Example
# Copy this file to .env and configure your values.

# Supabase Public Configuration (used by client-side browser and SSR)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-side Supabase Configuration (optional SSR fallbacks)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_PROJECT_ID="your-project-id"

# Server-only Secrets (NEVER expose to client browser)
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
# DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
# CRON_SECRET="your_secure_cron_secret"
